# Base URL of your WordPress site, no trailing slash
WP_BASE_URL=https://example.com

# WordPress username for the account owning the Application Password
WP_USERNAME=your-wordpress-username

# WordPress Application Password (Users > Profile > Application Passwords)
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Safety switches. Keep false initially.
WP_ALLOW_PUBLISH=false
WP_ALLOW_DELETE=false

# MCP HTTP server port
PORT=3000
